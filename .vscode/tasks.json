{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Benchmark Jar",
            "type": "shell",
            "command": "mvn",
            "args": [
                "-q",
                "-DskipTests",
                "package"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Build the standalone benchmark jar (BenchRunner)",
            "options": {
                "cwd": "${workspaceFolder}/FallChallenge2024-SeleniaCity"
            }
        },
        {
            "label": "Run Moon City Challenge",
            "type": "shell",
            "command": "python",
            "args": [
                "bench_full.py"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Run the full benchmark against the Python solution",
            "dependsOn": "Build Benchmark Jar"
        },
        {
            "type": "shell",
            "command": "echo 'Rebuild Protoc task completed'",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "label": "test Application"
          }
    ]
}